# Copy to .env and fill in. Never commit .env.
# Only NEXT_PUBLIC_* variables reach the browser (none are used yet).

# Database (MongoDB Atlas): Connect > Drivers. Put the database name before the "?".
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/kamshin?retryWrites=true&w=majority"

# First admin, created by `npm run db:seed`. The seed never overwrites an existing password.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="at-least-8-characters"
# SEED_ADMIN_NAME="Store Admin"

# Signs the session cookies. Generate with `npx auth secret`.
# Use a different one in production and keep it private.
AUTH_SECRET=""

# Store and admin hostnames, with the port when running locally.
# Locally the store is http://localhost:3000 and the admin http://admin.localhost:3000.
# In production e.g. STORE_HOST="kamshin.ng", ADMIN_HOST="admin.kamshin.ng"
# (the admin won't open anywhere if ADMIN_HOST isn't set in production).
STORE_HOST="localhost:3000"
ADMIN_HOST="admin.localhost:3000"

# Full store URL, used for "View store" links in the admin. Set this in production.
# STORE_URL="https://kamshin.ng"

# Rate limiting for login/signup (upstash.com or Vercel > Storage > Upstash).
# Can stay empty locally; set both in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional. Exchange rates for showing prices in other currencies.
# EXCHANGE_RATES_URL="https://open.er-api.com/v6/latest"

# Not used yet (checkout and photo uploads aren't built):
# PAYSTACK_SECRET_KEY="sk_test_..."
# SHIPPING_FLAT_FEE_KOBO="250000"
# BLOB_READ_WRITE_TOKEN=""
